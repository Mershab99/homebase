apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: dad-winners
  namespace: argocd
spec:
  project: default
  source:
    repoURL: 'https://gitlab.com/mershab-homelab/dad/winners.git'
    targetRevision: main
    path: 'charts/winners'
    helm:
#        - name: someParameter
#          value: someValue
      values: |
        image:
          repository: mershab99/winners
          pullPolicy: IfNotPresent
          # Overrides the image tag whose default is the chart appVersion.
          tag: "main"
        service:
          type: ClusterIP
        ingress:
          enabled: true
          annotations:
            kubernetes.io/ingress.class: nginx
          hosts:
          - host: winners.mershab.com
            paths:
              - path: /
                pathType: ImplementationSpecific
          - host: novmar.mershab.com
            paths:
              - path: /
                pathType: ImplementationSpecific
  destination:
    name: loft-homelab-vcluster-vcluster-dad
    namespace: winners 
  syncPolicy:
    automated: 
      selfHeal: true
      prune: true
    syncOptions:
      - CreateNamespace=true
      - priority=8
